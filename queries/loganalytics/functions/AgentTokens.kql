let AgentTokens = (lookback:timespan) {
    // Which span type carries token usage in your stack.
    //   "chat"         = one span per model call (Foundry, Semantic Kernel, most frameworks)
    //   "invoke_agent" = use this instead if usage is only reported on the agent run span
    // Never list both: a parent span and its child spans can report the same tokens and you would double count.
    let tokenOps = dynamic(["chat"]);
    AppDependencies
    | where TimeGenerated > ago(lookback)
    | extend Op = tostring(Properties["gen_ai.operation.name"])
    | where Op in (tokenOps)
    | extend InTok  = tolong(Properties["gen_ai.usage.input_tokens"]),
             OutTok = tolong(Properties["gen_ai.usage.output_tokens"])
    | where isnotnull(InTok) or isnotnull(OutTok)
    | project
        timestamp      = TimeGenerated,
        Agent          = coalesce(tostring(Properties["gen_ai.agent.name"]), AppRoleName),
        Model          = coalesce(tostring(Properties["gen_ai.response.model"]), tostring(Properties["gen_ai.request.model"])),
        Operation      = Op,
        InputTokens    = coalesce(InTok, long(0)),
        OutputTokens   = coalesce(OutTok, long(0)),
        TotalTokens    = coalesce(InTok, long(0)) + coalesce(OutTok, long(0)),
        DurationMs     = todouble(DurationMs),
        Succeeded      = tobool(Success),
        ConversationId = coalesce(tostring(Properties["gen_ai.conversation.id"]), OperationId),
        User           = coalesce(tostring(Properties["user.email"]), tostring(Properties["enduser.id"]), UserAuthenticatedId, UserId),
        OperationId    = OperationId
};
