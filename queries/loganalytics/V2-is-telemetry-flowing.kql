// V2: Is telemetry flowing?
// Which event names and GenAI operations arrived in the last hour, so you know which of the queries below can return data for you.
union AppEvents, AppDependencies
| where TimeGenerated > ago(1h)
| extend Op = tostring(Properties["gen_ai.operation.name"])
| where Name startswith "Bot" or isnotempty(Op)
| summarize Records = count(), Agents = dcount(coalesce(tostring(Properties["gen_ai.agent.name"]), AppRoleName)) by Table = $table, EventName = Name, Op
| order by Records desc
