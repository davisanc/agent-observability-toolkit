// P8: Agent run latency and failures
// End-to-end invoke_agent spans: runs, failures and latency percentiles per agent and model.
AppDependencies
| where TimeGenerated > ago(7d)
| where tostring(Properties["gen_ai.operation.name"]) == "invoke_agent"
| summarize Runs = count(), Failed = countif(tobool(Success) == false),
            P50ms = round(percentile(todouble(DurationMs), 50)), P95ms = round(percentile(todouble(DurationMs), 95))
            by Agent = coalesce(tostring(Properties["gen_ai.agent.name"]), AppRoleName), Model = tostring(Properties["gen_ai.request.model"])
| extend FailureRatePct = round(100.0 * Failed / Runs, 1)
| order by Runs desc
